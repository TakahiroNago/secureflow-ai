# SecureFlow AI — environment template
#
# 1. Copy this file:  cp .env.example .env
# 2. Replace EVERY "change-me-..." value with a strong random value
#    (e.g. `openssl rand -base64 32`).
# 3. Never commit .env (it is listed in .gitignore).
#
# This file must only ever contain dummy values.

# Change these three together to run another copy side by side (README "複数環境の同時起動").
# The project name isolates containers, networks, volumes and the PHP image tag.
COMPOSE_PROJECT_NAME=secureflow
# Host ports (bound to 127.0.0.1 only). If you change NGINX_PORT, update APP_URL as well.
NGINX_PORT=8080
FRONTEND_PORT=5173

# UID/GID of your WSL2 user (`id -u` / `id -g`); the PHP containers run as this user
HOST_UID=1000
HOST_GID=1000

# ---- Laravel ---------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
LOG_LEVEL=info

# ---- PostgreSQL ------------------------------------------------------------
# Bootstrap superuser: used ONLY by the postgres container's init scripts.
POSTGRES_PASSWORD=change-me-postgres-superuser

# Database names
DB_DATABASE=secureflow
DB_TEST_DATABASE=secureflow_test

# Application role (DML only). Passed to app / worker / scheduler.
DB_USERNAME=secureflow_app
DB_PASSWORD=change-me-app-role

# Owner role (DDL / migrations). Passed ONLY to the "migrate" service.
DB_MIGRATOR_USERNAME=secureflow_owner
DB_MIGRATOR_PASSWORD=change-me-owner-role

# Test database owner role (DDL on the test database only). Passed ONLY to the "test" service.
# It cannot connect to the development database.
DB_TEST_MIGRATOR_USERNAME=secureflow_test_owner
DB_TEST_MIGRATOR_PASSWORD=change-me-test-owner-role

# Test application role (DML on the test database only). Passed ONLY to the "test" service.
# It cannot connect to the development database, and DB_USERNAME cannot connect to the test one.
DB_TEST_USERNAME=secureflow_test_app
DB_TEST_PASSWORD=change-me-test-app-role

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# ---- Optional tuning -------------------------------------------------------
# Provisional values with their defaults; unset is fine. compose.yaml passes these to app, worker and
# scheduler. Recreate the containers after a change. See docs/architecture.md §11.
# AUDIT_LOGIN_IP_LIMIT_PER_MINUTE=30
# AUDIT_SYSTEM_CHAIN_LIMIT_PER_MINUTE=600
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_LOCK_TIMEOUT_MS=3000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000
# REDIS_TIMEOUT=2
# REDIS_READ_TIMEOUT=2
# REDIS_MAX_RETRIES=3

# ---- AI ----------------------------------------------------------------------
# "mock" needs nothing else. "openai" needs all three below, and refuses to start otherwise
# (docs/security-design.md §6.1). Put a key only in your .env, and never commit it.
# "openai" also needs COMPOSE_PROFILES=openai: the worker has no way out without the relay.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
