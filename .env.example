# SecureFlow AI — environment template
#
# 1. Copy this file:  cp .env.example .env
# 2. Replace EVERY "change-me-..." value with a strong random value
#    (e.g. `openssl rand -base64 32`).
# 3. Never commit .env (it is listed in .gitignore).
#
# This file must only ever contain dummy values.

COMPOSE_PROJECT_NAME=secureflow

# UID/GID of your WSL2 user (`id -u` / `id -g`); the PHP containers run as this user
HOST_UID=1000
HOST_GID=1000

# ---- Laravel ---------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
LOG_LEVEL=info

# ---- PostgreSQL ------------------------------------------------------------
# Bootstrap superuser: used ONLY by the postgres container's init scripts.
POSTGRES_PASSWORD=change-me-postgres-superuser

# Database names
DB_DATABASE=secureflow
DB_TEST_DATABASE=secureflow_test

# Application role (DML only). Passed to app / worker / scheduler.
DB_USERNAME=secureflow_app
DB_PASSWORD=change-me-app-role

# Owner role (DDL / migrations). Passed ONLY to the "migrate" service.
DB_MIGRATOR_USERNAME=secureflow_owner
DB_MIGRATOR_PASSWORD=change-me-owner-role

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
