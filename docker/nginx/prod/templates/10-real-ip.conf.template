# SecureFlow AI — rendered to /etc/nginx/conf.d/10-real-ip.conf at start by the nginx image, from TRUSTED_PROXY_CIDR
# (compose.prod.yaml). Only a connection from the load balancer may say who the client is: X-Forwarded-For from
# anywhere else is ignored, and nginx fails to start without a value (docs/security-design.md §22 A-2).
# The address then reaches php-fpm as REMOTE_ADDR, and the application trusts no proxy of its own.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;
